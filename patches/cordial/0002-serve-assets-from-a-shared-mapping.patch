+/// Directory of pre-extracted assets, from `CORDIAL_ASSET_MMAP_DIR`. Read once.
+fn mapped_root() -> Option<&'static Path> {
+    static ROOT: OnceLock<Option<PathBuf>> = OnceLock::new();
+    ROOT.get_or_init(|| {
+        let p = PathBuf::from(std::env::var_os("CORDIAL_ASSET_MMAP_DIR")?);
+        (p.is_absolute() && p.is_dir()).then_some(p)
+    })
+    .as_deref()
+}
+
+extern "C" {
+    fn mmap(addr: *mut c_void, len: usize, prot: c_int, flags: c_int, fd: c_int, off: i64) -> *mut c_void;
+}
+
 impl Manager {
+    /// `assets/<name>` as a mapping of the extracted copy, or `None` to fall
+    /// back to reading the APK.
+    ///
+    /// **Lifetime.** The mapping is never unmapped, which is the same contract
+    /// `Vec::leak` gave: `AAsset_getBuffer`'s pointer stays valid after the
+    /// asset is closed, for the life of the process, so a caller that keeps it
+    /// cannot be left with a dangling one. What changes is whose memory it is:
+    /// `MAP_PRIVATE` over a file, so untouched pages are the page cache's (shared
+    /// between clients, reclaimable when clean) and only a page the engine writes
+    /// becomes the process's own, copy-on-write, exactly as a write to the old
+    /// buffer would have been.
+    ///
+    /// **Checks.** The name must be a plain relative path (no `..`, no root);
+    /// the file must be a regular file, not a symlink; its length must equal the
+    /// APK entry's uncompressed size. Anything else returns `None` and the APK is
+    /// read as before, so a stale or tampered tree cannot silently substitute a
+    /// differently sized asset. The contents are not re-hashed per read: the tree
+    /// is verified when it is installed (`cordial-import verify`).
+    fn map_extracted(&self, name: &str) -> Option<&'static [u8]> {
+        use std::os::fd::AsRawFd;
+        use std::path::Component;
+        let root = mapped_root()?;
+        let rel = Path::new(name);
+        if name.is_empty() || !rel.components().all(|c| matches!(c, Component::Normal(_))) {
+            return None;
+        }
+        let path = root.join(rel);
+        let md = std::fs::symlink_metadata(&path).ok()?;
+        if !md.file_type().is_file() {
+            return None;
+        }
+        let len = md.len();
+        let want = {
+            let mut zip = self.archive()?;
+            let entry = zip.by_name(&format!("assets/{name}")).ok()?;
+            entry.size()
+        };
+        if want != len {
+            return None;
+        }
+        if len == 0 {
+            return Some(&[]);
+        }
+        let file = File::open(&path).ok()?;
+        // SAFETY: a fresh mapping of `len` bytes of a file this process just
+        // opened; the result is checked against MAP_FAILED before use.
+        let ptr = unsafe { mmap(std::ptr::null_mut(), len as usize, 3 /* PROT_READ|PROT_WRITE */, 2 /* MAP_PRIVATE */, file.as_raw_fd(), 0) };
+        if ptr as isize == -1 {
+            return None;
+        }
+        // SAFETY: the mapping is `len` bytes, is never unmapped (so `'static`
+        // holds), and is only ever handed out as shared bytes.
+        Some(unsafe { std::slice::from_raw_parts(ptr as *const u8, len as usize) })
+    }
+
     /// A private archive handle sharing the one parsed central directory, or
     /// `None` if the APK could not be read.
     fn archive(&self) -> Option<zip::ZipArchive<ApkReader>> {
@@ -248,6 +317,21 @@
