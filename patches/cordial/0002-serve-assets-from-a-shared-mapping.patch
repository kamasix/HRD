+        // Fleet-manager patch. When `CORDIAL_ASSET_MMAP_DIR` names a tree that
+        // holds the same assets already extracted (the importer makes one per
+        // installed build), serve the bytes from a mapping of that file instead
+        // of decompressing them into a private, never-freed buffer. The pages
+        // are file-backed: every client mapping the same file shares them, and
+        // the kernel can reclaim the clean ones. See `map_extracted`.
+        if let Some(mapped) = self.map_extracted(name) {
+            if trace_assets_enabled() {
+                eprintln!("[asset] hit (mapped): {name}");
+            }
+            record(name, Served::Apk);
+            self.cache.lock().ok()?.insert(name.to_string(), mapped);
+            return Some(mapped);
+        }
