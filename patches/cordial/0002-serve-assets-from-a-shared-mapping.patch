+#[cfg(test)]
+mod mapped_tests {
+    use super::*;
+
+    /// Run alone (`cargo test -p cordial-runtime mapped_assets -- --test-threads=1`):
+    /// the extracted-tree root is read from the environment once per process.
+    #[test]
+    fn mapped_assets_come_from_the_extracted_tree_and_are_checked() {
+        let dir = std::env::temp_dir().join(format!("cordial-mapped-test-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        let tree = dir.join("tree");
+        std::fs::create_dir_all(tree.join("sub")).unwrap();
+        let apk = dir.join("base.apk");
+        {
+            let mut out = Vec::new();
+            {
+                let mut w = zip::ZipWriter::new(std::io::Cursor::new(&mut out));
+                let opts: zip::write::FileOptions<'_, ()> =
+                    zip::write::FileOptions::default().compression_method(zip::CompressionMethod::Deflated);
+                for (n, c) in [("assets/a.txt", &b"hello hello hello hello"[..]), ("assets/sub/b.bin", &b"0123456789"[..]), ("assets/empty", &b""[..]), ("assets/wrong", &b"four"[..]), ("assets/link", &b"target"[..])] {
+                    w.start_file(n, opts).unwrap();
+                    std::io::Write::write_all(&mut w, c).unwrap();
+                }
+                w.finish().unwrap();
+            }
+            std::fs::write(&apk, out).unwrap();
+        }
+        std::fs::write(tree.join("a.txt"), b"hello hello hello hello").unwrap();
+        std::fs::write(tree.join("sub/b.bin"), b"0123456789").unwrap();
+        std::fs::write(tree.join("empty"), b"").unwrap();
+        std::fs::write(tree.join("wrong"), b"fourteen bytes!").unwrap(); // size differs from the APK entry
+        std::fs::write(dir.join("outside"), b"target").unwrap();
+        std::os::unix::fs::symlink(dir.join("outside"), tree.join("link")).unwrap();
+        std::env::set_var("CORDIAL_ASSET_MMAP_DIR", &tree);
+
+        let m = Manager { apk: apk.clone(), archive: OnceLock::new(), cache: Mutex::new(HashMap::new()) };
+        let a = m.read("a.txt").unwrap();
+        assert_eq!(a, b"hello hello hello hello");
+        assert_eq!(m.read("sub/b.bin").unwrap(), b"0123456789");
+        assert_eq!(m.read("empty").unwrap(), b"");
+        // Served from a mapping of the tree, not from a heap copy.
+        let maps = std::fs::read_to_string("/proc/self/maps").unwrap();
+        assert!(maps.lines().any(|l| l.ends_with("/tree/a.txt")), "a.txt is not mapped:\n{maps}");
+        // A second read returns the same pointer (cached), still valid.
+        assert_eq!(m.read("a.txt").unwrap().as_ptr(), a.as_ptr());
+        // A size mismatch falls back to the APK's own bytes.
+        assert_eq!(m.read("wrong").unwrap(), b"four");
+        // A symlink in the tree is never followed; the APK answers.
+        assert_eq!(m.read("link").unwrap(), b"target");
+        assert!(!std::fs::read_to_string("/proc/self/maps").unwrap().lines().any(|l| l.ends_with("/tree/link") || l.ends_with("/outside")));
+        // Names that try to leave the tree are refused by the mapped path.
+        assert!(m.map_extracted("../outside").is_none());
+        assert!(m.map_extracted("/etc/passwd").is_none());
+        // A write to a mapped buffer must not reach the file (MAP_PRIVATE).
+        // SAFETY: the test writes one byte inside the mapping it owns.
+        unsafe { *(a.as_ptr() as *mut u8) = b'J' };
+        assert_eq!(std::fs::read(tree.join("a.txt")).unwrap(), b"hello hello hello hello");
+        std::fs::remove_dir_all(dir).ok();
+    }
+}
